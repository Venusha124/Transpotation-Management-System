datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("CUSTOMER")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  walletBalance Float     @default(0)
  
  driverProfile Driver?
  auditLogs     AuditLog[]
  notifications Notification[]
  bookings      Booking[]
  disputes      Dispute[]
}

model Vehicle {
  id              String        @id @default(uuid())
  number          String        @unique
  type            String        
  capacity        Float         
  model           String
  brand           String
  fuelType        String        
  insuranceExpiry DateTime
  licenseExpiry   DateTime
  totalMileage    Float         @default(0)
  availability    Boolean       @default(true)
  status          String        @default("Available") 
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trips        Trip[]
  maintenance  Maintenance[]
  fuelLogs     FuelLog[]
}

model Driver {
  id               String      @id @default(uuid())
  name             String
  nic              String      @unique
  contact          String
  address          String
  licenseNumber    String      @unique
  experience       Int         
  emergencyContact String
  salary           Float
  availability     Boolean     @default(true)
  attendanceStatus String      @default("Absent") 
  rating           Float       @default(5.0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  
  userId           String?     @unique
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  trips    Trip[]
  fuelLogs FuelLog[]
}

model Trip {
  id             String     @id @default(uuid())
  trackingNumber String     @unique
  driverId       String
  driver         Driver     @relation(fields: [driverId], references: [id])
  vehicleId      String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id])
  pickup         String
  destination    String
  weight         Float
  cargoType      String
  status         String     @default("PENDING")
  eta            String     
  routePoints    String     
  waypoints      String     @default("[]")
  currentLat     Float?
  currentLng     Float?
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  routeId        String?
  route          Route?     @relation(fields: [routeId], references: [id], onDelete: SetNull)

  bookings       Booking[]
}

model Booking {
  id             String        @id @default(uuid())
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  pickup         String
  destination    String
  weight         Float
  cargoDetails   String
  deliveryType   String        
  status         String        @default("PENDING")
  paymentStatus  String        @default("PENDING")
  qrScanned      Boolean       @default(false)
  seatNumber     String?
  scheduledTime  DateTime
  rating         Int?
  feedback       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tripId         String?
  trip           Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  payments       Payment[]
  disputes       Dispute[]
}

model Maintenance {
  id            String            @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  type          String            
  description   String
  cost          Float
  status        String            @default("SCHEDULED")
  scheduledDate DateTime
  completedDate DateTime?
  partsUsed     String?           
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model FuelLog {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  liters    Float
  cost      Float
  mileage   Float    
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  amount        Float
  method        String        
  status        String        @default("PENDING")
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   
  createdAt DateTime @default(now())
}

// ─── Route Management System ────────────────────────────

model Stop {
  id        String      @id @default(uuid())
  name      String
  code      String      @unique
  address   String
  latitude  Float?
  longitude Float?
  status    String      @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  routeStops RouteStop[]
}

model Route {
  id            String      @id @default(uuid())
  name          String
  code          String      @unique
  startLocation String
  endLocation   String
  distance      Float       // km
  duration      Int         // minutes
  status        String      @default("DRAFT") // DRAFT | PUBLISHED
  type          String      @default("EXPRESS") // EXPRESS | INTERCITY | MULTI_ROUTE | CHARTER
  basePrice     Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  routeStops    RouteStop[]
  trips         Trip[]

  @@unique([startLocation, endLocation])
}

model RouteStop {
  id         String   @id @default(uuid())
  routeId    String
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId     String
  stop       Stop     @relation(fields: [stopId], references: [id])
  orderIndex Int      // 0 = first stop, 1 = second, etc.
  arrivalOffset Int   @default(0) // minutes from route start

  @@unique([routeId, stopId])
  @@unique([routeId, orderIndex])
}

model Dispute {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id])
  reason        String
  status        String   @default("OPEN") // OPEN, RESOLVED, REJECTED
  refundAmount  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

